{
  "expo": {
    "name": "Dave browz",
    "slug": "dave-browz",
    "scheme": "davebrowz",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bluecollarmedia.davebrowz",
      "infoPlist": {
        "CFBundleDisplayName": "Dave browz",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web links",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ]
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ]
    ],
    "owner": "abbacohen",
    "extra": {
      "eas": {
        "projectId": "642c73ae-4fcd-427e-a02d-9b8d733108ba"
      }
    }
  }
}
